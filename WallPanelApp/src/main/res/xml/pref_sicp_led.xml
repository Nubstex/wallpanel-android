<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/title_wled_simulation">

        <Preference
            android:key="pref_wled_info"
            android:textColor="@color/light_gray"
            android:textSize="12sp"
            android:selectable="false"
            android:paddingTop="0dp"/>

        <SwitchPreference
            android:defaultValue="false"
            android:key="pref_wled_simulation_enabled"
            android:title="@string/title_wled_simulation"
            android:summary="@string/summary_wled_simulation"/>

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/title_led_mode">

        <ListPreference
            android:key="pref_led_mode"
            android:title="@string/title_led_mode"
            android:summary="@string/summary_led_mode"
            android:entries="@array/led_mode_title"
            android:entryValues="@array/led_mode_values"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="pref_led_static_category"
        android:title="@string/pref_led_static_title">

        <SwitchPreference
            android:defaultValue="false"
            android:key="pref_led_static_on"
            android:title="@string/title_led_static_on"/>

        <EditTextPreference
            android:key="pref_led_static_color"
            android:title="@string/title_led_static_color"
            android:hint="@string/hint_led_color"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="pref_led_active_category"
        android:title="@string/pref_led_active_title">

        <EditTextPreference
            android:key="pref_led_active_color"
            android:title="@string/title_led_active_color"
            android:hint="@string/hint_led_color"/>

        <SwitchPreference
            android:defaultValue="false"
            android:key="pref_led_active_loop"
            android:title="@string/title_led_active_loop"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="pref_led_inactive_category"
        android:title="@string/pref_led_inactive_title">

        <EditTextPreference
            android:key="pref_led_inactive_color"
            android:title="@string/title_led_inactive_color"
            android:hint="@string/hint_led_color"/>

        <SwitchPreference
            android:defaultValue="false"
            android:key="pref_led_inactive_loop"
            android:title="@string/title_led_inactive_loop"/>

    </PreferenceCategory>

</PreferenceScreen>
