<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/title_sicp_screen_settings">

        <Preference
            android:key="button_sicp_screen_on"
            android:title="@string/title_sicp_screen_on"/>

        <Preference
            android:key="button_sicp_screen_off"
            android:title="@string/title_sicp_screen_off"/>

        <SwitchPreference
            android:defaultValue="false"
            android:key="pref_sicp_auto_screen_power"
            android:title="@string/title_sicp_auto_screen_power"
            android:summary="@string/summary_sicp_auto_screen_power"/>

    </PreferenceCategory>

</PreferenceScreen>
